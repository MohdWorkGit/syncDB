# Oracle connection
ORACLE_USER=app_user
ORACLE_PASSWORD=change_me
ORACLE_DSN=dbhost:1521/ORCLPDB1

# Throttling
BATCH_SIZE=1000          # change rows read/applied per cycle
SLEEP_SECONDS=5          # pause between cycles to keep DB load low

# Tables (override if your names differ). Any table name may be schema-qualified,
# e.g. SOURCE_TABLE=APPDATA.ORDER_CHANGES. Column names cannot be qualified.
SOURCE_TABLE=ORDER_CHANGES
TARGET_TABLE=ORDER_SUMMARY
KEY_COLUMN=CHANGE_ID     # indexed, unique, ascending column on the source (paging + resume)

# Operation column on the source: tells the engine what each row means
OP_COLUMN=OPERATION
OP_INSERT=I              # value meaning "insert this row into the target"
OP_UPDATE=U              # value meaning "update the existing target row"
OP_DELETE=D              # value meaning "delete the target row"

# User link table (optional): when LINK_TABLE is set, every change row with
# OP_INSERT also writes a link row connecting the new target row to a user. The
# row carries its own id (set to MAX(id)+1), the target business key, the fixed
# user id, and the fixed user section. Leave LINK_TABLE blank to disable;
# SYNC_USER_ID and SYNC_USER_SECTION are required when it is set.
LINK_TABLE=                    # e.g. ORDER_USER_LINK (blank = disabled)
LINK_ID_COLUMN=LINK_ID         # link table's own id column; sync sets it to MAX(id)+1
LINK_USER_COLUMN=USER_ID       # column in LINK_TABLE that holds the user id
LINK_SECTION_COLUMN=USER_SECTION  # column in LINK_TABLE that holds the user section
SYNC_USER_ID=                  # fixed user id recorded for each inserted row
SYNC_USER_SECTION=             # fixed user section recorded for each inserted row

# Processed flag (optional): when PROCESSED_COLUMN is set, the source is consumed
# as a work queue — only rows whose flag = PROCESSED_PENDING are read, and they
# are stamped PROCESSED_DONE in the same transaction that applies them. Leave
# PROCESSED_COLUMN blank to keep keyset paging + checkpoint instead.
PROCESSED_COLUMN=        # e.g. PROCESSED (blank = disabled)
PROCESSED_PENDING=0      # flag value meaning "not yet applied"
PROCESSED_DONE=1         # flag value to set once applied

# Audit trail + quarantine (optional). HISTORY_TABLE records one row per change
# processed (the full per-row history). QUARANTINE_TABLE holds business keys whose
# insert failed: once a key is quarantined, all its later updates/deletes are
# skipped, and a failed insert no longer aborts the run (it is isolated and
# recorded). Leave blank to disable each.
HISTORY_TABLE=           # e.g. SYNC_ROW_HISTORY (blank = disabled)
QUARANTINE_TABLE=        # e.g. SYNC_QUARANTINE (blank = disabled)

# Resume support (keyset mode; ignored when PROCESSED_COLUMN is set)
CHECKPOINT_FILE=.sync_checkpoint.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=                # e.g. sync.log — also write logs to this file (blank = console only)
