# Oracle connection
ORACLE_USER=app_user
ORACLE_PASSWORD=change_me
ORACLE_DSN=dbhost:1521/ORCLPDB1

# Throttling
BATCH_SIZE=1000          # change rows read/applied per cycle
SLEEP_SECONDS=5          # pause between cycles to keep DB load low

# Source table (may be schema-qualified, e.g. APPDATA.ORDER_CHANGES). The engine
# does SELECT * from it, so any of its columns can be referenced as a :BIND in the
# SQL files below. The target table is named only inside those SQL files.
SOURCE_TABLE=ORDER_CHANGES
KEY_COLUMN=CHANGE_ID     # indexed, unique, ascending column on the source (paging + resume)

# Business key on the SOURCE (comma-separated for a composite key). Used only to
# track quarantine + history; not used to build any SQL.
BUSINESS_KEY_COLUMNS=ORDER_ID

# Operation column on the source: tells the engine which SQL file to run per row
OP_COLUMN=OPERATION
OP_INSERT=I              # value meaning "run the insert SQL"
OP_UPDATE=U              # value meaning "run the update SQL"
OP_DELETE=D              # value meaning "run the delete SQL"

# Per-operation SQL (one statement per file). Edit these to adapt the sync to your
# tables — the whole source->target transformation lives here. Each :NAME is bound
# from the source row by column name. The insert SQL may end with
# `RETURNING <id> INTO :NEW_ID` to hand the new row's id to the link SQL below.
INSERT_SQL_FILE=sql/insert.sql
UPDATE_SQL_FILE=sql/update.sql
DELETE_SQL_FILE=sql/delete.sql

# User link (optional): when LINK_SQL_FILE is set, it runs once after each
# successful insert. Its :NEW_ID bind is the id the insert SQL returned; every
# other :NAME is resolved from an environment variable of the same name (e.g.
# :SYNC_USER_ID -> SYNC_USER_ID below). Nothing from the source row. Leave
# LINK_SQL_FILE blank to disable linking.
LINK_SQL_FILE=                 # e.g. sql/link.sql (blank = disabled)
NEW_ID_BIND=NEW_ID             # bind name the insert SQL returns the new id into
SYNC_USER_ID=                  # env-var bind referenced by link.sql
SYNC_USER_SECTION=             # env-var bind referenced by link.sql

# Processed flag (optional): when PROCESSED_COLUMN is set, the source is consumed
# as a work queue — only rows whose flag = PROCESSED_PENDING are read, and they
# are stamped PROCESSED_DONE in the same transaction that applies them. Leave
# PROCESSED_COLUMN blank to keep keyset paging + checkpoint instead.
PROCESSED_COLUMN=        # e.g. PROCESSED (blank = disabled)
PROCESSED_PENDING=0      # flag value meaning "not yet applied"
PROCESSED_DONE=1         # flag value to set once applied

# Audit trail + quarantine (optional). HISTORY_TABLE records one row per change
# processed (the full per-row history). QUARANTINE_TABLE holds business keys whose
# insert failed: once a key is quarantined, all its later updates/deletes are
# skipped, and a failed insert no longer aborts the run (it is isolated and
# recorded). Leave blank to disable each.
HISTORY_TABLE=           # e.g. SYNC_ROW_HISTORY (blank = disabled)
QUARANTINE_TABLE=        # e.g. SYNC_QUARANTINE (blank = disabled)

# Resume support (keyset mode; ignored when PROCESSED_COLUMN is set)
CHECKPOINT_FILE=.sync_checkpoint.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=                # e.g. sync.log — also write logs to this file (blank = console only)
