# Oracle connection
ORACLE_USER=app_user
ORACLE_PASSWORD=change_me
ORACLE_DSN=dbhost:1521/ORCLPDB1

# Throttling
BATCH_SIZE=1000          # rows read/inserted per cycle
SLEEP_SECONDS=5          # pause between cycles to keep DB load low

# Tables (override if your names differ)
SOURCE_TABLE=SOURCE_ORDERS
TARGET_TABLE=ORDER_SUMMARY
KEY_COLUMN=ORDER_ID      # indexed, unique, monotonically usable column on the source

# Resume support
CHECKPOINT_FILE=.sync_checkpoint.json

# Logging
LOG_LEVEL=INFO
